# ============================================
# Environment Variables (.env tunggal)
# Digunakan untuk seluruh environment (dev & prod)
# ============================================

# --- App ---
NEXT_PUBLIC_APP_NAME="Elemes LMS"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- API ---
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_API_TIMEOUT=30000

# --- Features Flags ---
NEXT_PUBLIC_ENABLE_PWA=true

# --- SEO ---
NEXT_PUBLIC_SITE_TITLE="Elemes LMS"
NEXT_PUBLIC_SITE_DESCRIPTION="Elemes LMS — Universal Learning Management System Template"

# --- Locale ---
NEXT_PUBLIC_DEFAULT_LOCALE="id"

# --- Security & Cryptography (Server-Only) ---
# Wajib tepat 32 karakter (256-bit) untuk AES-256-GCM
ENCRYPTION_KEY="12345678901234567890123456789012"

# --- Obfuscation (Sqids) ---
SQIDS_ALPHABET="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
